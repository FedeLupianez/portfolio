---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale } from "../i18n";
---

<BaseLayout lang={defaultLocale}>
  <Header lang={defaultLocale} />
  <section>
    <Hero lang={defaultLocale} />
    <About lang={defaultLocale} />
    <Projects lang={defaultLocale} />
    <Experience lang={defaultLocale} />
    <Education lang={defaultLocale} />
  </section>
  <Footer lang={defaultLocale} />
</BaseLayout>
