---
import { getSiteConfig, type Locale } from "../i18n";
import Modal from "./Modal.astro";

interface Props {
    lang: Locale;
}

const { lang } = Astro.props;
const siteConfig = getSiteConfig(lang);
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-100">
              {siteConfig.ui.sections.experience}
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full bg-[var(--accent-color)]"
            />
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              {siteConfig.experience.map((exp, index) => (
                <div class="relative mb-12 last:mb-0">
                  {/* Timeline dot at top of card */}
                  <div
                    class="absolute left-1/2 -top-2 w-4 h-4 border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300 border-[var(--accent-color)] bg-[var(--accent-color)]"
                  />

                  {/* Connecting line below card */}
                  {index < siteConfig.experience.length - 1 && (
                    <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-300 -translate-x-1/2 translate-y-full z-10 dark:bg-neutral-700" />
                  )}

                  {/* Experience card */}
                  <button
                    type="button"
                    class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300 dark:bg-neutral-900 dark:border-neutral-800 w-full text-left focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] focus:ring-offset-2 dark:focus:ring-offset-neutral-900"
                    onclick={`document.getElementById('modal-${index}')?.setAttribute('data-modal', 'open')`}
                    aria-label={lang === 'es' ? `Ver detalles de ${exp.title || exp.company || 'experiencia'}` : `View details for ${exp.title || exp.company || 'experience'}`}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                      <div>
                        {exp.title && (
                          <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100">
                            {exp.title}
                          </h3>
                        )}
                        {exp.company && (
                          <p
                            class="text-base sm:text-lg text-[var(--accent-color)]"
                          >
                            {exp.company}
                          </p>
                        )}
                      </div>
                      {exp.dateRange && (
                        <span class="text-xs sm:text-sm text-gray-500 mt-2 sm:mt-0 dark:text-gray-400">
                          {exp.dateRange}
                        </span>
                      )}
                    </div>

                    {(exp.bullets?.length ?? 0) > 0 && (
                    <ul class="space-y-2">
                      {exp.bullets?.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0 dark:bg-neutral-600" />
                          <span class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                    )}

                    <div class="mt-4 flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
                      <span>{lang === 'es' ? 'Ver detalles' : 'View details'}</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    </div>
                  </button>
                </div>
              ))}

              {/* Modals */}
              {siteConfig.experience.map((exp, index) => (
                <Modal
                  id={`modal-${index}`}
                  lang={lang}
                  title={exp.title}
                  company={exp.company}
                  dateRange={exp.dateRange}
                  description={exp.description}
                  roleDescription={exp.roleDescription}
                  image={exp.image}
                  bullets={exp.bullets}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Modal trigger button hover effect */
  button:hover {
    transform: translateY(-2px);
  }

  /* Ensure cards look clickable */
  button:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }
</style>